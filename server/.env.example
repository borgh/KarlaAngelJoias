# Copie para .env e preencha antes de rodar localmente.
# Em produção, essas variáveis são passadas pelo deploy/docker/api/deploy.sh.

JWT_SECRET=troque-por-um-valor-aleatorio-longo
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Usados só na primeira execução do seed (npm run seed), para criar o admin inicial.
SEED_ADMIN_EMAIL=admin@karlaangeljoias.com.br
SEED_ADMIN_PASSWORD=TrocarSenha123!
SEED_ADMIN_NAME=Admin Karla Angel

# Opcionais — sem elas, a integração de WhatsApp fica indisponível sem
# quebrar o resto do sistema. Ver docs/development/environment-variables.md.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=karlaangeljoias
